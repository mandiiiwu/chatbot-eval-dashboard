# MicroDC.ai API key (console.microdc.ai -> API Keys) -- used for the judge model only
MDC_API_KEY=

# Target model ("the chatbot under test") runs locally via Ollama -- must
# match a model already pulled/created with `ollama list`. Required, no
# default: this harness evaluates whatever specific-purpose chatbot you
# point it at, so it won't silently assume one. Example below is our
# current validation subject (BioMistral-7B, chosen because its training
# corpus -- PubMed Central Open Access -- is real, documented, and legally
# reproducible, so the corpus/ directory can hold actual training-data
# excerpts rather than an approximation) -- swap for any other
# domain-specific model without touching code. Judge model scores the
# target's consistency and runs on MicroDC, deliberately a different model
# family than the target to avoid same-family judge bias.
# See harness/config.py for details. MicroDC catalog: https://api.microdc.ai/api/public/models
TARGET_MODEL=cniongolo/biomistral
MDC_JUDGE_MODEL=gpt-oss:120b

# Only needed if Ollama isn't running on the default local port.
# OLLAMA_BASE_URL=http://localhost:11434/v1