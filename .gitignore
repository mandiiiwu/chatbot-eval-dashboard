.env
__pycache__/
*.pyc
.venv/
results/*.json
results/*.html
results/*.log
results/*.jsonl
results/archive*/
!results/.gitkeep
.DS_Store

# This repo's own corpus/questions (this project's BioMistral/medical test data) --
# a fresh clone should start with an empty corpus and no question set, matching
# the "bring your own model and corpus" design goal, not this project's own
# validation data. See PLAN.md/memory for context.
corpus/*.md
corpus/*.txt
!corpus/.gitkeep
questions/*.json
!questions/.gitkeep

# internal planning/reference docs -- not part of the public release
PLAN.md
README_example.md

# Local Claude Code tool state -- machine-specific, never shared
.claude/
corpus/.claude/

# Leftover from an unrelated tool pointed at this directory -- not part of
# this project, see PLAN.md/memory for context.
corpus/.serena/
.serena/
